prefix_rule(
    pattern = ["git", "push", "--force"],
    decision = "forbidden",
    justification = "Force-push can overwrite shared history; use a normal push after review.",
    match = [
        "git push --force",
        "git push --force origin main",
    ],
    not_match = ["git push origin main"],
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Hard reset can destroy uncommitted work; inspect and preserve changes instead.",
    match = [
        "git reset --hard",
        "git reset --hard HEAD~1",
    ],
)

prefix_rule(
    pattern = ["rm", "-rf"],
    decision = "forbidden",
    justification = "Recursive forced deletion is unsafe; resolve and verify an exact target first.",
    match = [
        "rm -rf build",
        "rm -rf /",
    ],
)

prefix_rule(
    pattern = ["dotnet", "ef", "database", "drop"],
    decision = "prompt",
    justification = "Dropping the training database is destructive and requires confirmation.",
    match = [
        "dotnet ef database drop",
        "dotnet ef database drop --force",
    ],
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Remote changes must be reviewed before they are pushed.",
    match = [
        "git push",
        "git push origin main",
    ],
    not_match = ["git status"],
)

prefix_rule(
    pattern = ["dotnet", "build"],
    decision = "allow",
    justification = "Building the solution is a routine verification step.",
)

prefix_rule(
    pattern = ["dotnet", "test"],
    decision = "allow",
    justification = "Running tests is a routine verification step.",
)

prefix_rule(
    pattern = ["git", "status"],
    decision = "allow",
    justification = "Git status is read-only.",
)

prefix_rule(
    pattern = ["git", "diff"],
    decision = "allow",
    justification = "Git diff is read-only.",
)

prefix_rule(
    pattern = ["git", "log"],
    decision = "allow",
    justification = "Git log is read-only.",
)
