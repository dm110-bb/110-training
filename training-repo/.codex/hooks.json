{
  "description": "OrderHub project guardrails and edit audit log",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -File .codex/hooks/block-destructive-sql.ps1",
            "timeout": 10,
            "statusMessage": "Checking command for destructive SQL"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -File .codex/hooks/log-edits.ps1",
            "timeout": 10,
            "statusMessage": "Logging edited files"
          }
        ]
      }
    ]
  }
}
